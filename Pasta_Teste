  return `
    <div class="page-head">
      <div class="eyebrow">Pet Shop</div>
      <h2>Matilha Amiga</h2>
      <p>Informações de contato, endereço e funcionamento.</p>
    </div>
    <div class="card">
      <div class="about-row"><span class="ic">📍</span><div><div class="t">Endereço</div><div class="d">Rua das Flores, 245 — Contagem/MG</div></div></div>
